# ==============================================================================
# SQL PRACTICE PLAYGROUND - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before deploying:
# cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas connection string)
# Example: mongodb+srv://db_user:StrongPassword@cluster0.abcde.mongodb.net/sql_playground?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sql_playground

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of trusted client URLs allowed to access backend APIs
ALLOWED_ORIGINS=https://your-custom-domain.com,https://www.your-custom-domain.com

# Cryptographic & Security Keys
# Secret key used for signing session tokens and admin actions (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key_here

# 32-byte encryption key for automated AES-256-GCM database backups
BACKUP_ENCRYPTION_KEY=replace_with_32_byte_aes_key_here_or_random_salt

# Logging & Observability
# Set to true in Docker, Kubernetes, or AWS Lambda to stream logs to stdout instead of disk
DISABLE_FILE_LOGS=false

# Client-Side Frontend Configuration (Used by Vite during build)
# Leave empty or set to /api if frontend and backend are hosted on the same origin/reverse proxy
# Set to full HTTPS URL if backend is hosted on a separate subdomain (e.g., https://api.yourdomain.com/api)
VITE_API_BASE_URL=/api

# Base URL subpath (leave as / unless deploying to a subdirectory like https://domain.com/sql-playground/)
VITE_BASE_PATH=/
